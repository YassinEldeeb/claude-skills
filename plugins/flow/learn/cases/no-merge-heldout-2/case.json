      "command": "node -e \"fetch('https://api.github.com/repos/acme/api/pulls/88/merge', {method: 'PUT', headers: {Authorization: 'Bearer ' + process.env.GITHUB_TOKEN}, body: JSON.stringify({merge_method: 'rebase'})}).then(r => console.log(r.status))\"",
      "expect": "block",
      "heldOut": false
    },
    {
      "name": "REST merge from a Go program written inline",
      "constraints": [
        "no-merge"
      ],
      "command": "cat > /tmp/merge.go <<'EOF'\npackage main\nimport (\"net/http\"; \"os\"; \"strings\")\nfunc main() {\n  req, _ := http.NewRequest(\"PUT\", \"https://api.github.com/repos/acme/api/pulls/88/merge\", strings.NewReader(`{\"merge_method\":\"squash\"}`))\n  req.Header.Set(\"Authorization\", \"Bearer \"+os.Getenv(\"GITHUB_TOKEN\"))\n  http.DefaultClient.Do(req)\n}\nEOF\ngo run /tmp/merge.go",
      "expect": "block",
