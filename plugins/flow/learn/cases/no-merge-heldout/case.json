      "name": "curl --request PUT to the merge endpoint",
      "constraints": [
        "no-merge"
      ],
      "command": "curl --request PUT -H \"Authorization: Bearer $GITHUB_TOKEN\" https://api.github.com/repos/acme/api/pulls/42/merge -d '{\"merge_method\":\"squash\"}'",
      "expect": "block",
      "heldOut": false
    },
    {
      "name": "curl with combined -sX PUT",
      "constraints": [
        "no-merge"
      ],
      "command": "curl -sX PUT -H \"Authorization: token $GH_TOKEN\" https://api.github.com/repos/acme/api/pulls/17/merge",
      "expect": "block",
      "heldOut": false
    },
    {
      "name": "httpie http PUT to the merge endpoint",
      "constraints": [
        "no-merge"
      ],
      "command": "http PUT https://api.github.com/repos/acme/api/pulls/7/merge Authorization:\"token $GH_TOKEN\" merge_method=rebase",
      "expect": "block",
      "heldOut": false
    },
    {
      "name": "GraphQL mergePullRequest mutation inline",
      "constraints": [
        "no-merge"
      ],
      "command": "gh api graphql -f query='mutation { mergePullRequest(input: {pullRequestId: \"PR_kwDOA1\"}) { pullRequest { merged } } }'",
      "expect": "block",
      "heldOut": false
    },
    {
      "name": "GraphQL from a file named merge-pr.graphql (block: gh api graphql plus a merge-named query file states the intent)",
      "constraints": [
        "no-merge"
      ],
      "command": "gh api graphql -F query=@merge-pr.graphql -f id=PR_kwDOA1",
      "expect": "block",
      "heldOut": false
